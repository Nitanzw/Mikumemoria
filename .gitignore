# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_credentials.cfg

# Godot exported builds
build/
*.apk
*.aab
*.pck
*.exe

# Excepción: el APK de prueba y el AAB SIN FIRMAR van commiteados a
# propósito (ver dist/README.md). El APK es para instalar en el celular
# por cable; el AAB es el que se sube a Play, y va sin firmar porque la
# keystore de producción no pasa por acá ni por el repo.
!dist/*.apk
!dist/*.aab

# OS / editor
.DS_Store
*.swp

# Secretos (ver .env.example)
.env

# Python (tools/)
__pycache__/
*.pyc

# Hojas crudas de los sprite sheets, antes de partir y recortar. Sirven
# para volver a partirlas sin regenerar; no hacen falta en el repo.
assets/sprites/_sheets_raw/

# docs/ tiene .gdignore: Godot no la importa, así que no hay .import que versionar
docs/capturas/*.import
tools/*.import
